{
  "openapi": "3.1.0",
  "info": {
    "title": "NewSt · Кабинет исследователя",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/data/status": {
      "get": {
        "tags": [
          "data"
        ],
        "summary": "Data Status",
        "description": "Инвентарь data/: что лежит, за какие даты и насколько свежее.",
        "operationId": "data_status_api_data_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InventoryReport"
                }
              }
            }
          }
        }
      }
    },
    "/api/settings/instrument-order": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "Get Instrument Order",
        "description": "Порядок инструментов по разделам.",
        "operationId": "get_instrument_order_api_settings_instrument_order_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstrumentOrder"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "settings"
        ],
        "summary": "Patch Instrument Order",
        "description": "Заменяет порядок в присланных разделах, остальные не трогает.\n\nТак перестановка акций на телефоне не затрёт порядок фьючерсов, который\nтолько что поменяли на Маке.",
        "operationId": "patch_instrument_order_api_settings_instrument_order_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InstrumentOrder"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstrumentOrder"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/pipeline": {
      "get": {
        "tags": [
          "pipeline"
        ],
        "summary": "Pipeline State",
        "description": "Шаги, порядок «Обновить всё», журнал запусков и кто пишет данные вне пульта.",
        "operationId": "pipeline_state_api_pipeline_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PipelineState"
                }
              }
            }
          }
        }
      }
    },
    "/api/pipeline/runs": {
      "post": {
        "tags": [
          "pipeline"
        ],
        "summary": "Start Run",
        "description": "Запускает шаги в фоне. 409 — такой запуск уже идёт или данные пишет другой процесс.",
        "operationId": "start_run_api_pipeline_runs_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/pipeline/stop": {
      "post": {
        "tags": [
          "pipeline"
        ],
        "summary": "Stop Run",
        "description": "Остановить после текущего шага: текущий доработает, чтобы не испортить файлы.",
        "operationId": "stop_run_api_pipeline_stop_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StopRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/pipeline/log": {
      "get": {
        "tags": [
          "pipeline"
        ],
        "summary": "Run Log",
        "description": "Лог запуска с байта offset; пульт дочитывает его, пока запуск идёт.",
        "operationId": "run_log_api_pipeline_log_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogChunk"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
