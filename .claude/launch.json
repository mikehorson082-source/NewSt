{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cabinet-api",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "app.api.main:app",
        "--port",
        "8000",
        "--reload",
        "--reload-dir",
        "src",
        "--reload-dir",
        "app"
      ],
      "port": 8000
    },
    {
      "name": "cabinet-check",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "python", "-m", "app", "--port", "8012"],
      "port": 8012
    },
    {
      "name": "cabinet-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "app/frontend", "run", "dev"],
      "port": 5173
    }
  ]
}
